<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- MAIN SCREEN -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFDE7">

        <!-- ✅ HEADER BAR -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0D47A1"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ✅ Profile left -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="43dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF" />

            <!-- ✅ Center title -->
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Welcome MyApp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/headerProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/profile" />

            <!-- ✅ Menu Button -->
        </LinearLayout>

        <!-- ✅ CONTENT AREA FOR 4 SCREENS -->
        <FrameLayout
            android:id="@+id/containerBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="24dp">

            <!-- ✅ HOME CONTENT -->
            <LinearLayout
                android:id="@+id/contentHome"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/circle_bg"
                    android:padding="8dp"
                    android:src="@drawable/profile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Ganesh1!"
                    android:textColor="#F57F17"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ✅ MAP CONTENT -->
            <LinearLayout
                android:id="@+id/contentmap"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Map!"
                    android:textColor="#F57F17"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ✅ MESSAGE CONTENT -->
            <LinearLayout
                android:id="@+id/contentSMS"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to SMS!"
                    android:textColor="#F57F17"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/contentSettings"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <!-- ✅ SETTINGS CONTENT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to Settings"
                android:textColor="#F57F17"
                android:textSize="24sp"
                android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

        <!-- ✅ FOOTER NAVIGATION BAR -->
        <LinearLayout
            android:id="@+id/footerBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="#0D47A1"
            android:weightSum="4">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/white">
                <ImageView android:src="@drawable/home" android:layout_width="24dp" android:layout_height="24dp" />
                <TextView android:text="Home"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_map"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#e6ffff">
                <ImageView android:src="@drawable/map" android:layout_width="24dp" android:layout_height="24dp" />
                <TextView android:text="Map"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_sms"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/white">
                <ImageView android:src="@drawable/sms" android:layout_width="24dp" android:layout_height="24dp" />
                <TextView android:text="Message"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#e6ffff">
                <ImageView android:src="@drawable/setting" android:layout_width="24dp" android:layout_height="24dp" />
                <TextView
                    android:text="Settings"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp"  />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ✅ LEFT MENU PANEL -->
    <LinearLayout
        android:id="@+id/leftMenu"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/blue"
        android:padding="20dp"
        android:layout_gravity="start">

        <ImageView
            android:id="@+id/menuProfileImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/profile"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/menuUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_gravity="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/menuProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/black"
            android:background="@color/white"
            android:textSize="18sp"
            android:padding="15dp" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:background="@color/white"
            android:text="Settings"
            android:textSize="18sp"
            android:padding="15dp" />
        <TextView
            android:id="@+id/contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:background="@color/white"
            android:text="Contact us"
            android:shadowColor="@color/black"
            android:textSize="18sp"
            android:padding="15dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
